# Optional LLM for the bilingual plain-language summary. Leave empty to use template summaries.
ANTHROPIC_API_KEY=
LLM_MODEL=

# Optional helpline-sweep providers, tried in this order. With neither set, the sweep uses
# data/fixtures/maps_results.json and labels the results as simulated data.
GOOGLE_PLACES_API_KEY=
SERPAPI_KEY=

# Storage
DATABASE_URL=sqlite:///data/runtime/saqr.db

# Engine limits
SCAN_TIMEOUT_S=10
PAGE_CONCURRENCY=8

# Treat *.localhost demo hosts as scannable (demo mode only)
ALLOW_LOCALHOST_DEMO=false

# Origin of the web app, allowed by CORS
WEB_ORIGIN=http://localhost:5173
