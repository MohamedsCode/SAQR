{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "redirects": [
    { "source": "/", "destination": "/check", "permanent": false }
  ],
  "rewrites": [
    { "source": "/check", "destination": "/index.html" },
    { "source": "/api/health", "destination": "https://celebrity-pierce-tourist-background.trycloudflare.com/api/health" },
    { "source": "/api/brands", "destination": "https://celebrity-pierce-tourist-background.trycloudflare.com/api/brands" },
    { "source": "/api/check", "destination": "https://celebrity-pierce-tourist-background.trycloudflare.com/api/check" },
    { "source": "/api/report", "destination": "https://celebrity-pierce-tourist-background.trycloudflare.com/api/report" }
  ]
}
